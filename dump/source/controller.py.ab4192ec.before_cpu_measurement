 else:
  total=point[0]-CPU_PREVIOUS[0];idle=point[1]-CPU_PREVIOUS[1]
  if total>0:LAST_IDLE_CORES=(os.cpu_count() or 1)*idle/total
 CPU_PREVIOUS=point
