def cpu_idle_cores():
 global CPU_PREVIOUS,LAST_IDLE_CORES
 vals=list(map(int,pathlib.Path('/proc/stat').read_text().splitlines()[0].split()[1:]))
 point=(sum(vals),vals[3])
