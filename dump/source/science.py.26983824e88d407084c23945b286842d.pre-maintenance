def _now(): return datetime.now(timezone.utc).isoformat()
def _atomic_copy(src,dst,prefer_link=False):
    src=Path(src); dst=Path(dst); dst.parent.mkdir(parents=True,exist_ok=True)
    temp=dst.with_name(dst.name+".tmp")
    try:
        if prefer_link: os.link(src,temp)
        else: raise OSError("copy requested")
    except OSError: shutil.copy2(src,temp)
    os.replace(temp,dst)

def _json(path,obj):
    p=Path(path); p.parent.mkdir(parents=True,exist_ok=True); t=p.with_suffix(p.suffix+".tmp")
    t.write_text(json.dumps(obj,sort_keys=True,indent=2,default=_json_default)); os.replace(t,p)
def _json_default(x):
    if isinstance(x,(np.integer,)): return int(x)
    if isinstance(x,(np.floating,)): return float(x)
    if isinstance(x,np.ndarray): return x.tolist()
    if isinstance(x,Path): return str(x)
    raise TypeError(type(x).__name__)
def _sha(path):
    h=hashlib.sha256()
    with open(path,"rb") as f:
        for b in iter(lambda:f.read(1<<20),b""): h.update(b)
    return h.hexdigest()
def _keypath(runtime,key):
    if not isinstance(key,str) or not key or not re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*",key): raise ValueError("unsafe task key")
    root=(Path(runtime)/"artifacts").resolve(); p=(root/key).resolve()
    if root not in p.parents: raise ValueError("task key escapes artifact root")
    return p
def _project(runtime):
    p=Path(runtime).parent/"project"
    if not p.exists(): p=Path("/home/ubuntu/lamost_e1_migration_20261023/project")
    if str(p) not in sys.path: sys.path.insert(0,str(p))
    return p
def resolve_fit(runtime,key):
    p=_keypath(runtime,key)/"pipeline.joblib"
    if not p.exists(): raise FileNotFoundError(f"fit dependency missing: {p}")
    return p

