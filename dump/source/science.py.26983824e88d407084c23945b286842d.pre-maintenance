class ScientificFitFailure(RuntimeError):
    pass
class PhaseExecutionError(RuntimeError):
    def __init__(self, category, message):
        super().__init__(message); self.category=category

def _train_model(model,X,y,sample_weight=None):
    try:
        if sample_weight is not None and hasattr(model,"estimator"):
            model.estimator.fit(X,y,sample_weight=sample_weight)
            if not np.array_equal(model.estimator.classes_,np.arange(CLASSES)):
                raise ValueError("weighted estimator did not preserve all seven classes")
            return model
        if sample_weight is not None:
            raise ValueError(f"{type(model).__name__} does not support sample_weight")
        return model.fit(X,y)
    except Exception as e:
        raise ScientificFitFailure(f"{type(e).__name__}: {e}") from e
def _scores(model,X):
    if hasattr(model,"predict_proba"): return np.asarray(model.predict_proba(X),dtype=np.float64)
    if hasattr(model,"score_matrix"): return np.asarray(model.score_matrix(X),dtype=np.float64)
    raise TypeError("pipeline model has no seven-class score interface")
def _chunks(model,X,size=50000):
    out=[]
    for i in range(0,len(X),size): out.append(_scores(model,X[i:i+size]))
    return np.concatenate(out,axis=0)
def _alloc(counts,n):
    c=np.asarray(counts,dtype=np.float64)
    if c.shape!=(CLASSES,) or np.any(c<0) or c.sum()<=0: raise ValueError("invalid class counts")
    raw=c*n/c.sum(); base=np.floor(raw).astype(int)
    for i in np.argsort(-(raw-base),kind="stable")[:n-int(base.sum())]: base[i]+=1
    return base
